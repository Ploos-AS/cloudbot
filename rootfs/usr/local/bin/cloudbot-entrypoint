#!/bin/sh
set -eu

config="${CLOUDBOT_CONFIG:-/data/config.json}"
case "$config" in
  /*) ;;
  *) config="/data/$config" ;;
esac

prepare_runtime() {
  mkdir -p /data/data /data/logs

  if [ ! -e /data/plugins ]; then
    mkdir -p /data/plugins
    cp -a /usr/src/cloudbot/plugins/. /data/plugins/
  elif [ -L /data/plugins ]; then
    target="$(readlink /data/plugins || true)"
    if [ "$target" = "/usr/src/cloudbot/plugins" ]; then
      rm /data/plugins
      mkdir -p /data/plugins
      cp -a /usr/src/cloudbot/plugins/. /data/plugins/
    fi
  fi

  if [ "$config" != "/data/config.json" ]; then
    if [ -e /data/config.json ] && [ ! -L /data/config.json ]; then
      echo "Cannot activate $config because /data/config.json already exists as a regular file." >&2
      exit 64
    fi
    ln -sfn "$config" /data/config.json
  fi
}

case "${1:-run}" in
  run)
    shift || true
    if [ ! -f "$config" ]; then
      cat >&2 <<EOF
CloudBot is not configured yet.

Create a starter config:
  docker run --rm -v "$PWD/data:/data" ghcr.io/ploos-as/cloudbot:edge init

Then edit:
  $config

The container will remain idle until a config exists.
EOF
      exec sleep infinity
    fi
    prepare_runtime
    cd /data
    exec python -m cloudbot "$@"
    ;;
  init)
    shift || true
    if [ -e "$config" ]; then
      echo "Refusing to overwrite existing config: $config" >&2
      exit 64
    fi
    mkdir -p "$(dirname "$config")"
    cp /usr/src/cloudbot/config.default.json "$config"
    echo "Created $config"
    ;;
  shell)
    shift || true
    exec /bin/sh "$@"
    ;;
  *)
    exec "$@"
    ;;
esac
